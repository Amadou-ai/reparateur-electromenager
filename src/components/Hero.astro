---
const dossier = "N° DE FICHE — " + new Date().getFullYear() + "-IDF";
---

<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <span class="tag-mono">{dossier}</span>
      <h1>
        Une panne d'électroménager ?<br />
        On répare chez vous, sous 24&nbsp;h.
      </h1>
      <p class="lede">
        Lave-linge, réfrigérateur, four, lave-vaisselle, sèche-linge&nbsp;:
        toutes marques, tous modèles. Un technicien se déplace directement
        chez vous, partout en Île-de-France.
      </p>

      <div class="hero-actions">
        <a href="#ticket" class="btn btn-primary">Décrire ma panne</a>
        <a href="tel:+33600000000" class="btn btn-ghost">Appeler le technicien</a>
      </div>

      <ul class="hero-checks">
        <li>Devis gratuit avant intervention</li>
        <li>Toutes marques, tous appareils</li>
        <li>Déplacement dans tout l'IDF</li>
      </ul>
    </div>

    <div class="hero-figure" aria-hidden="true">
      <svg viewBox="0 0 420 460" class="machine-svg">
        <!-- caisson -->
        <rect x="60" y="40" width="260" height="380" rx="6" fill="none" stroke="var(--blueprint)" stroke-width="1.6"/>
        <!-- bandeau commandes -->
        <rect x="60" y="40" width="260" height="46" fill="none" stroke="var(--blueprint)" stroke-width="1.2"/>
        <circle cx="90" cy="63" r="9" fill="none" stroke="var(--ink)" stroke-width="1.2"/>
        <line x1="112" y1="55" x2="230" y2="55" stroke="var(--ink)" stroke-width="1.2"/>
        <line x1="112" y1="70" x2="200" y2="70" stroke="var(--ink)" stroke-width="1.2"/>
        <!-- hublot -->
        <circle cx="190" cy="270" r="92" fill="none" stroke="var(--ink)" stroke-width="1.8" class="draw"/>
        <circle cx="190" cy="270" r="72" fill="none" stroke="var(--line-strong)" stroke-width="1.2"/>
        <circle cx="190" cy="270" r="72" fill="none" stroke="var(--amber)" stroke-width="1.4" stroke-dasharray="4 7" class="drum"/>
        <!-- pieds -->
        <line x1="90" y1="420" x2="90" y2="434" stroke="var(--ink)" stroke-width="1.6"/>
        <line x1="290" y1="420" x2="290" y2="434" stroke="var(--ink)" stroke-width="1.6"/>

        <!-- lignes de cote -->
        <line x1="340" y1="40" x2="352" y2="40" stroke="var(--ink-soft)" stroke-width="1"/>
        <line x1="340" y1="420" x2="352" y2="420" stroke="var(--ink-soft)" stroke-width="1"/>
        <line x1="348" y1="40" x2="348" y2="420" stroke="var(--ink-soft)" stroke-width="1"/>
        <text x="356" y="234" class="dim-label" transform="rotate(90 356 234)">H. 82 CM</text>

        <!-- annotations -->
        <line x1="278" y1="270" x2="330" y2="180" stroke="var(--green)" stroke-width="1" stroke-dasharray="2 3"/>
        <circle cx="330" cy="180" r="2" fill="var(--green)"/>
        <text x="336" y="176" class="note">tambour — jeu &amp; roulement</text>

        <line x1="102" y1="63" x2="40" y2="20" stroke="var(--green)" stroke-width="1" stroke-dasharray="2 3"/>
        <circle cx="40" cy="20" r="2" fill="var(--green)"/>
        <text x="16" y="14" class="note">carte électronique</text>

        <line x1="190" y1="410" x2="140" y2="452" stroke="var(--green)" stroke-width="1" stroke-dasharray="2 3"/>
        <circle cx="140" cy="452" r="2" fill="var(--green)"/>
        <text x="60" y="456" class="note">pompe de vidange</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 88px;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
  }

  .hero-text h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-top: 12px;
    color: var(--ink);
  }

  .lede {
    display: block;
    margin-top: 22px;
    max-width: 46ch;
    font-size: 1.12rem;
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .hero-checks {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  .hero-checks li::before {
    content: "✓ ";
    color: var(--green);
  }

  .hero-figure {
    justify-self: center;
    width: 100%;
    max-width: 320px;
    order: -1;
  }

  .machine-svg {
    width: 100%;
    height: auto;
  }

  .machine-svg .note {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--ink-soft);
  }

  .machine-svg .dim-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-soft);
  }

  .machine-svg .drum {
    animation: spin 16s linear infinite;
    transform-origin: 190px 270px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .machine-svg .drum {
      animation: none;
    }
  }

  @media (min-width: 900px) {
    .hero-figure {
      max-width: 400px;
      order: 0;
    }
  }
</style>
