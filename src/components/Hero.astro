---
const dossier = "N° DE FICHE — " + new Date().getFullYear() + "-IDF";
---

<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <span class="tag-mono">{dossier}</span>
      <h1>
        Une panne d'électroménager ?<br />
        On répare chez vous, sous 24&nbsp;h.
      </h1>
      <p class="lede">
        Lave-linge, réfrigérateur, four, lave-vaisselle, sèche-linge&nbsp;:
        toutes marques, tous modèles. Un technicien se déplace directement
        chez vous, partout en Île-de-France.
      </p>

      <div class="hero-actions">
        <a href="#ticket" class="btn btn-primary">Décrire ma panne</a>
        <a href="tel:+33600000000" class="btn btn-ghost">Appeler le technicien</a>
      </div>

      <ul class="hero-checks">
        <li>Devis gratuit avant intervention</li>
        <li>Toutes marques, tous appareils</li>
        <li>Déplacement dans tout l'IDF</li>
      </ul>
    </div>

    <div class="hero-figure">
      <figure class="photo-sheet sheet">
        <img
          src="/images/technicien-reparation.png"
          alt="Technicien Ibrahima Électroménager agenouillé, en train de réparer un lave-linge ouvert à domicile"
          loading="eager"
          width="850"
          height="523"
        />
        <figcaption class="tag-mono">Intervention en cours — lave-linge</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 88px;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
  }

  .hero-text h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-top: 12px;
    color: var(--ink);
  }

  .lede {
    display: block;
    margin-top: 22px;
    max-width: 46ch;
    font-size: 1.12rem;
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .hero-checks {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  .hero-checks li::before {
    content: "✓ ";
    color: var(--green);
  }

  .hero-figure {
    justify-self: center;
    width: 100%;
    max-width: 320px;
    order: -1;
  }

  .photo-sheet {
    margin: 0;
    padding: 10px;
  }

  .photo-sheet img {
    width: 100%;
    height: auto;
    border-radius: 2px;
    filter: grayscale(0.15) contrast(1.03);
  }

  .photo-sheet figcaption {
    margin-top: 10px;
    padding: 0 4px;
  }

  @media (min-width: 900px) {
    .hero-figure {
      max-width: 400px;
      order: 0;
    }
  }
</style>
