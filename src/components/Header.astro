---
const nav = [
  { href: "#services", label: "Ce qu'on répare" },
  { href: "#comment-ca-marche", label: "Comment ça marche" },
  { href: "#zone", label: "Zone d'intervention" },
  { href: "#avis", label: "Avis" },
];
---

<header class="header">
  <div class="wrap header-inner">
    <a class="brand" href="#top">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1" y="1" width="28" height="28" rx="2" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="15" cy="16" r="7.5" stroke="currentColor" stroke-width="1.6"/>
        <path d="M15 16 L15 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M15 16 L18.2 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M6 5.5 H24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <span>
        Ibrahima <strong>Électroménager</strong>
      </span>
    </a>

    <nav class="main-nav" aria-label="Navigation principale">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a class="btn btn-primary header-cta" href="#ticket">
      Décrire ma panne
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(238, 241, 236, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1.5px solid var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--blueprint);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .main-nav {
    display: none;
    gap: 28px;
    font-size: 0.95rem;
  }

  .main-nav a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .main-nav a:hover {
    color: var(--blueprint);
  }

  .header-cta {
    padding: 10px 18px;
    font-size: 0.92rem;
  }

  @media (min-width: 860px) {
    .main-nav {
      display: flex;
    }
  }
</style>
