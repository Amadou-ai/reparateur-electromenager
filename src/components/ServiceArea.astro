---
const departements = [
  "75 — Paris",
  "92 — Hauts-de-Seine",
  "93 — Seine-Saint-Denis",
  "94 — Val-de-Marne",
  "78 — Yvelines",
  "91 — Essonne",
  "95 — Val-d'Oise",
  "77 — Seine-et-Marne",
];
---

<section id="zone">
  <div class="wrap zone-grid">
    <div class="section-head" style="margin-bottom: 0;">
      <span class="kicker">Zone d'intervention</span>
      <h2>Un technicien mobile dans toute l'Île-de-France</h2>
      <p>
        Basé en petite couronne, le déplacement est possible dans les huit
        départements franciliens. Indiquez votre ville dans la fiche
        d'intervention pour confirmer un créneau.
      </p>
    </div>

    <ul class="dept-list">
      {departements.map((d) => (
        <li>{d}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .zone-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 820px) {
    .zone-grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
  }

  .dept-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ink);
    border: 1.5px solid var(--ink);
    align-self: stretch;
  }

  .dept-list li {
    background: var(--paper-raised);
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink);
  }

</style>
