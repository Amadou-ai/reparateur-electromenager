---
const appliances = [
  {
    name: "Lave-linge",
    detail: "Essorage, vidange, bruit anormal, panne électrique",
    icon: "washer",
  },
  {
    name: "Réfrigérateur & congélateur",
    detail: "Ne refroidit plus, givre excessif, fuite",
    icon: "fridge",
  },
  {
    name: "Four & plaque de cuisson",
    detail: "Chauffe irrégulière, résistance, allumage",
    icon: "oven",
  },
  {
    name: "Lave-vaisselle",
    detail: "Vidange bloquée, fuite, ne démarre plus",
    icon: "dishwasher",
  },
  {
    name: "Sèche-linge",
    detail: "Ne chauffe plus, tambour bloqué, filtre",
    icon: "dryer",
  },
  {
    name: "Hotte & petit électroménager",
    detail: "Moteur, éclairage, autres pannes du quotidien",
    icon: "hood",
  },
];
---

<section id="services">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker">Ce qu'on répare</span>
      <h2>Toutes marques, tous appareils</h2>
      <p>
        Si ça se branche et que ça vous rend service tous les jours, on sait
        probablement le réparer. Voici les pannes les plus fréquentes.
      </p>
    </div>

    <div class="services-grid">
      {appliances.map((a) => (
        <div class="service-card">
          <svg viewBox="0 0 48 48" class="service-icon" aria-hidden="true">
            {a.icon === "washer" && (
              <>
                <rect x="6" y="6" width="36" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="27" r="12" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="27" r="7" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="12" cy="11" r="1.4" fill="currentColor"/>
                <circle cx="17" cy="11" r="1.4" fill="currentColor"/>
              </>
            )}
            {a.icon === "fridge" && (
              <>
                <rect x="11" y="5" width="26" height="38" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <line x1="11" y1="19" x2="37" y2="19" stroke="currentColor" stroke-width="1.6"/>
                <line x1="17" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="17" y1="23" x2="17" y2="33" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </>
            )}
            {a.icon === "oven" && (
              <>
                <rect x="6" y="8" width="36" height="32" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <rect x="11" y="19" width="26" height="16" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="12" cy="13" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="19" cy="13" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="26" cy="13" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
              </>
            )}
            {a.icon === "dishwasher" && (
              <>
                <rect x="7" y="6" width="34" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <line x1="7" y1="15" x2="41" y2="15" stroke="currentColor" stroke-width="1.6"/>
                <line x1="14" y1="24" x2="34" y2="24" stroke="currentColor" stroke-width="1"/>
                <line x1="14" y1="30" x2="34" y2="30" stroke="currentColor" stroke-width="1"/>
                <line x1="14" y1="36" x2="34" y2="36" stroke="currentColor" stroke-width="1"/>
              </>
            )}
            {a.icon === "dryer" && (
              <>
                <rect x="6" y="6" width="36" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="27" r="12" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M19 27a5 5 0 0 1 10 0" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="12" cy="11" r="1.4" fill="currentColor"/>
              </>
            )}
            {a.icon === "hood" && (
              <>
                <path d="M8 12 L40 12 L32 24 L16 24 Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <line x1="24" y1="24" x2="24" y2="38" stroke="currentColor" stroke-width="1.6"/>
                <line x1="16" y1="38" x2="32" y2="38" stroke="currentColor" stroke-width="1.6"/>
              </>
            )}
          </svg>
          <h3>{a.name}</h3>
          <p>{a.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ink);
    border: 1.5px solid var(--ink);
  }

  @media (min-width: 560px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 860px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: var(--paper-raised);
    padding: 30px 26px;
  }

  .service-icon {
    width: 40px;
    height: 40px;
    color: var(--blueprint);
    margin-bottom: 18px;
  }

  .service-card h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .service-card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

</style>
