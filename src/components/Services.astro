---
const appliances = [
  {
    name: "Lave-linge",
    detail: "Essorage, vidange, bruit anormal, panne électrique",
    icon: "washer",
  },
  {
    name: "Réfrigérateur & congélateur",
    detail: "Ne refroidit plus, givre excessif, fuite",
    icon: "fridge",
  },
  {
    name: "Four & plaque de cuisson",
    detail: "Chauffe irrégulière, résistance, allumage",
    icon: "oven",
  },
  {
    name: "Lave-vaisselle",
    detail: "Vidange bloquée, fuite, ne démarre plus",
    icon: "dishwasher",
  },
  {
    name: "Sèche-linge",
    detail: "Ne chauffe plus, tambour bloqué, filtre",
    icon: "dryer",
  },
  {
    name: "Hotte & petit électroménager",
    detail: "Moteur, éclairage, autres pannes du quotidien",
    icon: "hood",
  },
];
---

<section id="services">
  <div class="wrap services-wrap">
    <svg viewBox="0 0 420 460" class="machine-svg" aria-hidden="true">
      <!-- caisson -->
      <rect x="60" y="40" width="260" height="380" rx="6" fill="none" stroke="var(--blueprint)" stroke-width="1.6"/>
      <!-- bandeau commandes -->
      <rect x="60" y="40" width="260" height="46" fill="none" stroke="var(--blueprint)" stroke-width="1.2"/>
      <circle cx="90" cy="63" r="9" fill="none" stroke="var(--ink)" stroke-width="1.2"/>
      <line x1="112" y1="55" x2="230" y2="55" stroke="var(--ink)" stroke-width="1.2"/>
      <line x1="112" y1="70" x2="200" y2="70" stroke="var(--ink)" stroke-width="1.2"/>
      <!-- hublot -->
      <circle cx="190" cy="270" r="92" fill="none" stroke="var(--ink)" stroke-width="1.8"/>
      <circle cx="190" cy="270" r="72" fill="none" stroke="var(--line-strong)" stroke-width="1.2"/>
      <circle cx="190" cy="270" r="72" fill="none" stroke="var(--amber)" stroke-width="1.4" stroke-dasharray="4 7" class="drum"/>
      <!-- pieds -->
      <line x1="90" y1="420" x2="90" y2="434" stroke="var(--ink)" stroke-width="1.6"/>
      <line x1="290" y1="420" x2="290" y2="434" stroke="var(--ink)" stroke-width="1.6"/>

      <!-- lignes de cote -->
      <line x1="340" y1="40" x2="352" y2="40" stroke="var(--ink-soft)" stroke-width="1"/>
      <line x1="340" y1="420" x2="352" y2="420" stroke="var(--ink-soft)" stroke-width="1"/>
      <line x1="348" y1="40" x2="348" y2="420" stroke="var(--ink-soft)" stroke-width="1"/>
      <text x="356" y="234" class="dim-label" transform="rotate(90 356 234)">H. 82 CM</text>

      <!-- annotations -->
      <line x1="278" y1="270" x2="330" y2="180" stroke="var(--green)" stroke-width="1" stroke-dasharray="2 3"/>
      <circle cx="330" cy="180" r="2" fill="var(--green)"/>
      <text x="336" y="176" class="note">tambour — jeu &amp; roulement</text>

      <line x1="102" y1="63" x2="40" y2="20" stroke="var(--green)" stroke-width="1" stroke-dasharray="2 3"/>
      <circle cx="40" cy="20" r="2" fill="var(--green)"/>
      <text x="16" y="14" class="note">carte électronique</text>

      <line x1="190" y1="410" x2="140" y2="452" stroke="var(--green)" stroke-width="1" stroke-dasharray="2 3"/>
      <circle cx="140" cy="452" r="2" fill="var(--green)"/>
      <text x="60" y="456" class="note">pompe de vidange</text>
    </svg>

    <div class="section-head">
      <span class="kicker">Ce qu'on répare</span>
      <h2>Toutes marques, tous appareils</h2>
      <p>
        Si ça se branche et que ça vous rend service tous les jours, on sait
        probablement le réparer. Voici les pannes les plus fréquentes.
      </p>
    </div>

    <div class="services-grid">
      {appliances.map((a) => (
        <div class="service-card">
          <svg viewBox="0 0 48 48" class="service-icon" aria-hidden="true">
            {a.icon === "washer" && (
              <>
                <rect x="6" y="6" width="36" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="27" r="12" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="27" r="7" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="12" cy="11" r="1.4" fill="currentColor"/>
                <circle cx="17" cy="11" r="1.4" fill="currentColor"/>
              </>
            )}
            {a.icon === "fridge" && (
              <>
                <rect x="11" y="5" width="26" height="38" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <line x1="11" y1="19" x2="37" y2="19" stroke="currentColor" stroke-width="1.6"/>
                <line x1="17" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <line x1="17" y1="23" x2="17" y2="33" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </>
            )}
            {a.icon === "oven" && (
              <>
                <rect x="6" y="8" width="36" height="32" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <rect x="11" y="19" width="26" height="16" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="12" cy="13" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="19" cy="13" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="26" cy="13" r="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/>
              </>
            )}
            {a.icon === "dishwasher" && (
              <>
                <rect x="7" y="6" width="34" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <line x1="7" y1="15" x2="41" y2="15" stroke="currentColor" stroke-width="1.6"/>
                <line x1="14" y1="24" x2="34" y2="24" stroke="currentColor" stroke-width="1"/>
                <line x1="14" y1="30" x2="34" y2="30" stroke="currentColor" stroke-width="1"/>
                <line x1="14" y1="36" x2="34" y2="36" stroke="currentColor" stroke-width="1"/>
              </>
            )}
            {a.icon === "dryer" && (
              <>
                <rect x="6" y="6" width="36" height="36" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="27" r="12" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M19 27a5 5 0 0 1 10 0" fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="12" cy="11" r="1.4" fill="currentColor"/>
              </>
            )}
            {a.icon === "hood" && (
              <>
                <path d="M8 12 L40 12 L32 24 L16 24 Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <line x1="24" y1="24" x2="24" y2="38" stroke="currentColor" stroke-width="1.6"/>
                <line x1="16" y1="38" x2="32" y2="38" stroke="currentColor" stroke-width="1.6"/>
              </>
            )}
          </svg>
          <h3>{a.name}</h3>
          <p>{a.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-wrap {
    position: relative;
  }

  .machine-svg {
    display: none;
    position: absolute;
    top: -20px;
    right: -20px;
    width: 220px;
    height: auto;
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }

  .machine-svg .note {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--ink-soft);
  }

  .machine-svg .dim-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-soft);
  }

  .machine-svg .drum {
    animation: spin 16s linear infinite;
    transform-origin: 190px 270px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .machine-svg .drum {
      animation: none;
    }
  }

  @media (min-width: 760px) {
    .machine-svg {
      display: block;
    }
  }

  .services-wrap .section-head {
    position: relative;
    z-index: 1;
  }

  .services-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ink);
    border: 1.5px solid var(--ink);
  }

  @media (min-width: 560px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 860px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: var(--paper-raised);
    padding: 30px 26px;
  }

  .service-icon {
    width: 40px;
    height: 40px;
    color: var(--blueprint);
    margin-bottom: 18px;
  }

  .service-card h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .service-card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

</style>
